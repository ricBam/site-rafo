---
// src/components/Hero.astro
//
// O logo saiu daqui: agora ele vive no cabecalho, em todas as paginas.
// Repetir a marca duas vezes na mesma dobra so gastava a altura que a
// frase precisa.
import WhatsAppButton from './WhatsAppButton.astro';
import Icon from './Icon.astro';
import { empresa } from '../data/empresa';
---
<section class="hero">
  <div class="container hero-inner">
    <p class="hero-local">
      {empresa.endereco.cidade}, {empresa.endereco.uf} <span aria-hidden="true">·</span> atendemos todo o Brasil
    </p>
    <h1 class="hero-title">Enquanto você não responde, o cliente já fechou com outro.</h1>
    <p class="hero-subtitle">A gente implementa atendimento automático no WhatsApp, presença no Google e um site que fecha negócio, prontos pra funcionar sem você precisar contratar mais gente.</p>
    <div class="hero-cta"><WhatsAppButton label="Quero meu diagnóstico gratuito" /></div>
    <div class="hero-pillars">
      <span class="pillar"><Icon name="google" size={18} /> Google</span>
      <span class="pillar"><Icon name="whatsapp" size={18} /> WhatsApp</span>
      <span class="pillar"><Icon name="site" size={18} /> Site</span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(3.5rem, 2rem + 7vw, 6.5rem) 0 var(--space-xl);
    text-align: center;
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-m);
  }
  .hero-local {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-muted);
  }
  .hero-local span { color: var(--color-accent-secondary); }
  .hero-title {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
    max-width: 16ch;
    animation: hero-title-reveal 0.9s cubic-bezier(0.65, 0, 0.35, 1) both;
    animation-delay: 0.1s;
  }
  .hero-subtitle {
    font-size: var(--step-1);
    line-height: 1.6;
    max-width: 54ch;
    color: var(--color-text);
  }
  .hero-cta { margin-top: var(--space-2xs); }
  .hero-pillars {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-m);
    margin-top: var(--space-2xs);
  }
  .pillar {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-accent-secondary);
  }

  .hero-local, .hero-subtitle, .hero-cta, .hero-pillars {
    animation: hero-rise 0.7s var(--ease-saida) both;
  }
  .hero-local { animation-delay: 0s; }
  .hero-subtitle { animation-delay: 0.3s; }
  .hero-cta { animation-delay: 0.42s; }
  .hero-pillars { animation-delay: 0.54s; }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes hero-title-reveal {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-title, .hero-local, .hero-subtitle, .hero-cta, .hero-pillars {
      animation: none;
      clip-path: none;
    }
  }
</style>
