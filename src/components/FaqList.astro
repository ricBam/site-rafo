---
// src/components/FaqList.astro
//
// Acordeão de perguntas frequentes. Existe porque a marcação e o estilo
// estavam duplicados entre Faq.astro (home) e ServicoLayout.astro, e a
// Fase 3 acrescenta mais páginas com FAQ próprio. Dado já era de fonte
// única; agora a apresentação também é.
import type { PerguntaFrequente } from '../data/empresa';

interface Props {
  faq: PerguntaFrequente[];
  /** Atraso incremental do reveal por item. 0 desliga. */
  passoDelay?: number;
}

const { faq, passoDelay = 0 } = Astro.props;
---
<div class="faq-list">
  {faq.map((item, i) => (
    <details
      class="faq-item"
      data-reveal
      style={passoDelay ? `transition-delay: ${i * passoDelay}s` : undefined}
    >
      <summary>{item.pergunta}</summary>
      <p>{item.resposta}</p>
    </details>
  ))}
</div>

<style>
  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 2rem; }
  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.1rem 1.4rem;
  }
  .faq-item summary {
    cursor: pointer;
    font-family: var(--font-heading);
    font-weight: 700;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+';
    float: right;
    font-family: var(--font-mono);
    color: var(--color-accent-secondary);
    display: inline-block;
    transition: transform var(--dur) var(--ease-saida);
  }
  .faq-item[open] summary::after { content: '\2212'; transform: rotate(180deg); }
  .faq-item p { margin-top: 0.85rem; opacity: 0.85; }

  /* Abrir/fechar sem transição nenhuma destoava do resto do site (nav,
     cards, hero, todos com o mesmo easing). CSS transition não roda no
     salto de display:none pra block que o navegador faz ao abrir um
     <details> — só @keyframes toca nesse instante, que é o mesmo motivo
     pelo qual .nav-painel/.menu-mobile-painel (SiteHeader.astro) já usam
     animação em vez de transição para o mesmo tipo de salto. */
  .faq-item[open] p {
    animation: faq-resposta-entrar var(--dur-lenta) var(--ease-saida) both;
  }
  @keyframes faq-resposta-entrar {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 0.85; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-item summary::after { transition: none; }
    .faq-item[open] p { animation: none; }
  }
</style>
