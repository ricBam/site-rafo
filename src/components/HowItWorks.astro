---
// src/components/HowItWorks.astro
const steps = [
  'Conversamos sobre como seu atendimento funciona hoje',
  'Construímos sob medida pro seu fluxo real',
  'Acompanhamos de perto até funcionar do jeito certo',
];
---
<section class="section" id="como-funciona">
  <div class="container">
    <h2 class="section-title">Como funciona</h2>
    <ol class="steps">
      {steps.map((step, i) => (
        <li>
          <span class="step-number">{i + 1}</span>
          <span class="step-text">{step}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 2rem;
    position: relative;
    padding-left: 1.2rem;
  }
  .steps::before {
    content: '';
    position: absolute;
    left: 1.2rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--color-border);
  }
  .steps li {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    position: relative;
  }
  .step-number {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1.3rem;
    color: var(--color-detail);
    min-width: 2.5rem;
    background: var(--color-bg);
  }
  .step-text { font-size: 1.05rem; }
</style>
