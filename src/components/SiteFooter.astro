---
// src/components/SiteFooter.astro
import Logo from './Logo.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { empresa } from '../data/empresa';
import { rotuloDoPerfil } from '../lib/perfis';
---
<section class="section final-cta">
  <div class="container">
    <h2 class="section-title" data-reveal>Bora começar seu diagnóstico?</h2>
    <p class="final-cta-text" data-reveal style="transition-delay: 0.08s">Sem compromisso, é só pra entender onde você pode estar perdendo cliente.</p>
    <WhatsAppButton label="Quero meu diagnóstico gratuito" />
  </div>
</section>

<footer class="site-footer">
  <div class="container footer-inner">
    <Logo variant="compact" />
    <nav class="footer-links" aria-label="Rodapé">
      <a href="/sobre/">Sobre</a>
      {empresa.perfis.map((perfil) => (
        <a href={perfil} rel="me noopener" target="_blank">{rotuloDoPerfil(perfil)}</a>
      ))}
    </nav>
    <div class="footer-meta">
      <p>Resende, RJ. Atendemos todo o Brasil remotamente.</p>
      <p>&copy; {new Date().getFullYear()} {empresa.nome}</p>
    </div>
  </div>
</footer>

<style>
  .final-cta { text-align: center; }
  .final-cta-text {
    opacity: 0.8;
    font-size: 0.98rem;
    max-width: 460px;
    margin: 0 auto 1.75rem;
  }
  .site-footer {
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .footer-links {
    display: flex;
    gap: 1.25rem;
    font-size: 0.85rem;
  }
  .footer-links a {
    color: inherit;
    opacity: 0.7;
    text-decoration: none;
  }
  .footer-links a:hover {
    opacity: 1;
    color: var(--color-accent-secondary);
  }
  .footer-meta {
    text-align: right;
  }
  .footer-meta p {
    font-size: 0.85rem;
    opacity: 0.6;
    margin: 0;
  }
  @media (max-width: 640px) {
    .footer-inner { justify-content: center; text-align: center; }
    .footer-meta { text-align: center; }
  }
</style>
