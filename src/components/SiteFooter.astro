---
// src/components/SiteFooter.astro
import Logo from './Logo.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { empresa } from '../data/empresa';
import { rotuloDoPerfil } from '../lib/perfis';
import { listaPaginasLegais } from '../data/legal';
---
<section class="section final-cta">
  <div class="container">
    <h2 class="section-title" data-reveal>Bora começar seu diagnóstico?</h2>
    <p class="final-cta-text" data-reveal style="transition-delay: 0.08s">Sem compromisso, é só pra entender onde você pode estar perdendo cliente.</p>
    <WhatsAppButton label="Quero meu diagnóstico gratuito" />
  </div>
</section>

<footer class="site-footer">
  <div class="container footer-inner">
    <Logo variant="compact" />
    <nav class="footer-links" aria-label="Rodapé">
      <a href="/sobre/">Sobre</a>
      <a href="/guias/">Guias</a>
      <a href="/contato/">Contato</a>
      {empresa.perfis.map((perfil) => (
        <a href={perfil} rel="me noopener" target="_blank">{rotuloDoPerfil(perfil)}</a>
      ))}
    </nav>
    <div class="footer-meta">
      <p>Resende, RJ. Atendemos todo o Brasil remotamente.</p>
      <p>&copy; {new Date().getFullYear()} {empresa.nome}</p>
    </div>
  </div>
  <nav class="container footer-legal" aria-label="Documentos legais">
    {listaPaginasLegais.map((p) => (
      <a href={`/${p.slug}/`}>{p.nome}</a>
    ))}
    <button type="button" class="footer-cookies" data-abrir-cookies>Preferências de cookies</button>
  </nav>
</footer>

<style>
  .final-cta { text-align: center; }
  .final-cta-text {
    opacity: 0.8;
    font-size: var(--step--1);
    max-width: 460px;
    margin: 0 auto 1.75rem;
  }
  .site-footer {
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .footer-links {
    display: flex;
    gap: 1.25rem;
    font-size: var(--step--1);
  }
  .footer-links a {
    color: inherit;
    opacity: 0.7;
    text-decoration: none;
  }
  /* Linha dos documentos legais: menor e mais discreta que a navegação,
     mas presente em toda página, que é o que a LGPD cobra. */
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-border);
    font-size: var(--step--2);
  }
  .footer-legal a {
    color: inherit;
    opacity: 0.6;
    text-decoration: none;
  }
  .footer-legal a:hover {
    opacity: 1;
    color: var(--color-accent-secondary);
  }
  /* Botão, não link: ele não leva a lugar nenhum, só reabre o aviso de
     cookies. Visual igual ao dos links vizinhos. */
  .footer-cookies {
    font: inherit;
    color: inherit;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    opacity: 0.6;
  }
  .footer-cookies:hover {
    opacity: 1;
    color: var(--color-accent-secondary);
  }
  .footer-links a:hover {
    opacity: 1;
    color: var(--color-accent-secondary);
  }
  .footer-meta {
    text-align: right;
  }
  .footer-meta p {
    font-size: var(--step--1);
    opacity: 0.6;
    margin: 0;
  }
  @media (max-width: 640px) {
    .footer-inner { justify-content: center; text-align: center; }
    .footer-meta { text-align: center; }
    .footer-legal { justify-content: center; }
  }
</style>
