---
// src/components/HowAndWho.astro
import Icon from './Icon.astro';
const steps = [
  { icon: 'whatsapp', text: 'Conversamos sobre como seu atendimento funciona hoje' },
  { icon: 'build', text: 'Construímos sob medida pro seu fluxo real' },
  { icon: 'watch', text: 'Acompanhamos de perto até funcionar do jeito certo' },
] as const;
---
<section class="section" id="como-funciona">
  <div class="container">
    <h2 class="section-title" data-reveal>Como funciona</h2>
    <div class="steps">
      {steps.map((step, i) => (
        <div class:list={['step-card', { 'step-right': i % 2 === 1 }]} data-reveal style={`transition-delay: ${i * 0.1}s`}>
          <span class="step-icon"><Icon name={step.icon} size={20} /></span>
          <div class="step-body">
            <span class="step-num">{`0${i + 1}`}</span>
            <p class="step-text">{step.text}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="who-wrap">
      <div class="who-card" id="para-quem" data-reveal>
        <p class="who-label">Pra quem é</p>
        <p>Negócios locais com agenda cheia e WhatsApp como canal principal de contato, prontos pra parar de perder cliente por demora no atendimento.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .steps {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2.5rem;
  }
  .step-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.1rem 1.35rem;
    width: min(520px, 88%);
    align-self: flex-start;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .step-card:hover {
    border-color: var(--color-accent-secondary);
    transform: translateY(-2px);
  }
  .step-right {
    align-self: flex-end;
  }
  @media (max-width: 640px) {
    .step-card, .step-right {
      align-self: stretch;
      width: 100%;
    }
  }
  .step-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-accent-secondary);
    flex-shrink: 0;
  }
  .step-body { display: flex; flex-direction: column; gap: 0.15rem; }
  .step-num {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.78rem;
    color: var(--color-detail);
    letter-spacing: 0.05em;
  }
  .step-text { font-size: 1.02rem; }

  .who-wrap {
    display: flex;
    justify-content: center;
    margin-top: 3.5rem;
  }
  .who-card {
    max-width: 560px;
    width: 100%;
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .who-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(320px circle at var(--mx, 50%) var(--my, 50%), rgba(224, 159, 62, 0.12), transparent 60%);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .who-card:hover::before { opacity: 1; }
  .who-label {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.78rem;
    color: var(--color-accent-secondary);
    margin-bottom: 0.75rem;
  }
</style>
