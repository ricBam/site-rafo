---
// src/components/Faq.astro
import { empresa } from '../data/empresa';
const faqs = empresa.faq;
---
<section class="section" id="faq">
  <div class="container">
    <h2 class="section-title" data-reveal>Perguntas frequentes</h2>
    <div class="faq-list">
      {faqs.map((item, i) => (
        <details class="faq-item" data-reveal style={`transition-delay: ${i * 0.08}s`}>
          <summary>{item.pergunta}</summary>
          <p>{item.resposta}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 2rem; }
  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.1rem 1.4rem;
  }
  .faq-item summary {
    cursor: pointer;
    font-family: var(--font-heading);
    font-weight: 700;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+';
    float: right;
    font-family: var(--font-mono);
    color: var(--color-accent-secondary);
  }
  .faq-item[open] summary::after { content: '\2212'; }
  .faq-item p { margin-top: 0.85rem; opacity: 0.85; }
</style>
