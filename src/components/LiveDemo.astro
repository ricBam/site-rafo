---
// src/components/LiveDemo.astro
import WhatsAppButton from './WhatsAppButton.astro';
---
<section class="section live-demo" id="veja-funcionando">
  <div class="container">
    <h2 class="section-title">Veja funcionando</h2>
    <p class="section-lead">Não é papo, é WhatsApp de verdade. Clica no botão abaixo e fala com um dos nossos agentes agora mesmo.</p>
    <WhatsAppButton label="Testar o agente agora" />
  </div>
</section>

<style>
  .live-demo {
    text-align: center;
  }
  .live-demo .section-lead {
    margin-left: auto;
    margin-right: auto;
  }
</style>
