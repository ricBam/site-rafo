---
// src/components/ChatMockup.astro
const stats = [
  { value: 24, suffix: '/7', label: 'Atendimento automático, todo santo dia' },
  { value: 0, suffix: '', label: 'Mensagens de cliente sem resposta enquanto você dorme' },
  { value: 3, suffix: '', label: 'Frentes cuidadas juntas: Google, WhatsApp e site' },
] as const;
---
<section class="section chat-signature" id="veja-funcionando">
  <div class="container">
    <p class="eyebrow">Veja como funciona na prática</p>
    <h2 class="section-title">Não é promessa, é isso rodando de verdade.</h2>
    <div class="signature-grid">
      <div class="phone-frame" id="chat-phone">
        <div class="chat-thread" id="chat-thread">
          <div class="bubble bubble-them"><p>Oi, vocês têm horário livre amanhã à tarde?</p><span class="bubble-meta">14:02</span></div>
          <div class="bubble bubble-us"><p>Oi! Temos sim 😊 Às 14h ou às 16h, qual fica melhor pra você?</p><span class="bubble-meta">14:02 ✓✓</span></div>
          <div class="bubble bubble-them"><p>16h é ótimo!</p><span class="bubble-meta">14:03</span></div>
          <div class="bubble bubble-us"><p>Perfeito, já deixei reservado. Te mando a confirmação por aqui ✅</p><span class="bubble-meta">14:03 ✓✓</span></div>
        </div>
      </div>
      <div class="stats-column">
        {stats.map((s, i) => (
          <div class="stat" data-reveal style={`transition-delay: ${i * 0.12}s`}>
            <p class="stat-value" data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</p>
            <p class="stat-label">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const CONVERSATION = [
    { from: 'them', text: 'Oi, vocês têm horário livre amanhã à tarde?', time: '14:02' },
    { from: 'us', text: 'Oi! Temos sim 😊 Às 14h ou às 16h, qual fica melhor pra você?', time: '14:02' },
    { from: 'them', text: '16h é ótimo!', time: '14:03' },
    { from: 'us', text: 'Perfeito, já deixei reservado. Te mando a confirmação por aqui ✅', time: '14:03' },
  ];

  function bubble(msg: { from: string; text: string; time: string }) {
    const el = document.createElement('div');
    el.className = `bubble bubble-${msg.from}`;
    const text = document.createElement('p');
    text.textContent = msg.text;
    const meta = document.createElement('span');
    meta.className = 'bubble-meta';
    meta.textContent = msg.from === 'us' ? `${msg.time} ✓✓` : msg.time;
    el.appendChild(text);
    el.appendChild(meta);
    return el;
  }

  function typingBubble() {
    const el = document.createElement('div');
    el.className = 'bubble bubble-us bubble-typing';
    el.innerHTML = '<span></span><span></span><span></span>';
    return el;
  }

  async function playSequence(thread: HTMLElement) {
    thread.innerHTML = '';
    for (const msg of CONVERSATION) {
      if (msg.from === 'us') {
        const typing = typingBubble();
        thread.appendChild(typing);
        thread.scrollTop = thread.scrollHeight;
        await new Promise((r) => setTimeout(r, 900));
        typing.remove();
      } else {
        await new Promise((r) => setTimeout(r, 500));
      }
      thread.appendChild(bubble(msg));
      thread.scrollTop = thread.scrollHeight;
      await new Promise((r) => setTimeout(r, 600));
    }
  }

  const thread = document.getElementById('chat-thread');
  const phone = document.getElementById('chat-phone');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (thread && phone && !prefersReducedMotion) {
    let played = false;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && !played) {
            played = true;
            playSequence(thread);
          }
        }
      },
      { threshold: 0.4 }
    );
    observer.observe(phone);
  }

  if (phone && !prefersReducedMotion) {
    phone.addEventListener('mousemove', (e) => {
      const rect = phone.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      phone.style.transform = `perspective(800px) rotateY(${x * 8}deg) rotateX(${-y * 8}deg)`;
    });
    phone.addEventListener('mouseleave', () => {
      phone.style.transform = '';
    });
  }

  function animateCount(el: HTMLElement) {
    const target = Number(el.dataset.count);
    const suffix = el.dataset.suffix ?? '';
    if (!Number.isFinite(target) || target <= 0) return;
    const duration = 900;
    const start = performance.now();
    function tick(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const current = Math.round(progress * target);
      el.textContent = `${current}${suffix}`;
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  if (!prefersReducedMotion) {
    const values = document.querySelectorAll<HTMLElement>('.stat-value');
    const statsObs = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            statsObs.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.5 }
    );
    values.forEach((v) => statsObs.observe(v));
  }
</script>

<style>
  .chat-signature { text-align: center; }
  .eyebrow {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--step--2);
    color: var(--color-detail);
    margin-bottom: 0.75rem;
  }
  .signature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    margin-top: 2.5rem;
    text-align: left;
  }
  @media (min-width: 800px) {
    .signature-grid { grid-template-columns: auto 1fr; }
  }
  .phone-frame {
    margin: 0 auto;
    width: min(380px, 100%);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 24px;
    padding: 1rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    transition: transform 0.15s ease;
    transform-style: preserve-3d;
  }
  .chat-thread {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 320px;
  }
  .bubble {
    max-width: 78%;
    padding: 0.6rem 0.85rem;
    border-radius: 14px;
    font-size: var(--step--1);
    line-height: 1.4;
    text-align: left;
  }
  .bubble p { margin: 0; }
  .bubble-meta {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    margin-top: 0.25rem;
    text-align: right;
  }
  .bubble-them {
    align-self: flex-start;
    background: #23201a;
    color: var(--color-text);
    border-bottom-left-radius: 4px;
  }
  /* Opacidade calculada por par cor/fundo, não um valor único repetido:
     0.6 falhava contraste real (4.44:1 e 3.67:1, medido por Lighthouse)
     porque o fundo verde da bolha enviada é mais escuro que o cinza da
     recebida. Cada bolha precisa do próprio ajuste para os dois passarem
     de 4.5:1. */
  .bubble-them .bubble-meta { opacity: 0.68; }
  .bubble-us .bubble-meta { opacity: 0.8; }
  .bubble-us {
    align-self: flex-end;
    background: color-mix(in srgb, var(--color-whatsapp) 22%, var(--color-surface));
    color: var(--color-text);
    border-bottom-right-radius: 4px;
  }
  .bubble-typing {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    padding: 0.7rem 0.9rem;
  }
  .bubble-typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-text);
    opacity: 0.6;
    animation: typing-blink 1s infinite ease-in-out;
  }
  .bubble-typing span:nth-child(2) { animation-delay: 0.15s; }
  .bubble-typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes typing-blink {
    0%, 80%, 100% { opacity: 0.3; transform: translateY(0); }
    40% { opacity: 1; transform: translateY(-3px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bubble-typing span { animation: none; opacity: 0.6; }
  }
  .stats-column {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .stat-value {
    font-family: var(--font-mono);
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 500;
    color: var(--color-accent-secondary);
  }
  .stat-label {
    margin-top: 0.35rem;
    opacity: 0.8;
    font-size: var(--step--1);
    max-width: 280px;
  }
</style>
