---
// src/layouts/BaseLayout.astro
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/600.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import ExitIntentModal from '../components/ExitIntentModal.astro';
import JsonLd from '../components/JsonLd.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { empresa } from '../data/empresa';

interface Props {
  title: string;
  description: string;
  /**
   * Imagem de compartilhamento e o texto que a descreve. Andam juntos de
   * propósito: um alt que descreve outra imagem é pior que nenhum, e prop
   * separado deixaria trocar só a imagem e esquecer o alt.
   */
  og?: { imagem: string; alt: string };
  /** og:type. "article" nas paginas de conteudo, "website" no resto. */
  ogType?: string;
  extraJsonLd?: Record<string, unknown>[];
}

const OG_PADRAO = {
  imagem: '/og/default.png',
  alt: 'Cartão da R.A.F.O. com o nome da marca, a frase Atendimento no WhatsApp, sites e Google, e a linha Resende, RJ. Atendemos todo o Brasil.',
};

const { title, description, og = OG_PADRAO, ogType = 'website', extraJsonLd } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(og.imagem, Astro.site);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" sizes="192x192" href="/logo/rafo-compact.png" />
    <link rel="apple-touch-icon" href="/logo/rafo-compact.png" />

    <meta name="robots" content="index,follow,max-image-preview:large" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={empresa.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />

    <JsonLd extra={extraJsonLd} />

    <script is:inline>
      // A revelacao ao rolar e feita em CSS puro por animation-timeline.
      // Este bloco existe so para o navegador que ainda nao tem isso, e e
      // deliberadamente conservador: so esconde conteudo se tiver, aqui e
      // agora, como revelar de volta. Sem JS, sem IntersectionObserver ou
      // sem os dois, a pagina chega inteira e visivel. Roda antes da
      // pintura para nao piscar.
      (function () {
        var temTimeline = window.CSS && CSS.supports && CSS.supports('animation-timeline: view()');
        if (temTimeline || !('IntersectionObserver' in window)) return;
        var raiz = document.documentElement;
        raiz.classList.add('sem-scroll-timeline');
        document.addEventListener('DOMContentLoaded', function () {
          var observador = new IntersectionObserver(
            function (entradas) {
              for (var i = 0; i < entradas.length; i++) {
                if (!entradas[i].isIntersecting) continue;
                entradas[i].target.classList.add('is-visible');
                observador.unobserve(entradas[i].target);
              }
            },
            { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
          );
          var alvos = document.querySelectorAll('[data-reveal]');
          for (var i = 0; i < alvos.length; i++) observador.observe(alvos[i]);
        });
      })();
    </script>
  </head>
  <body>
    <a class="pular-para-conteudo" href="#conteudo">Pular para o conteúdo</a>
    <SiteHeader />
    <main id="conteudo">
      <slot />
    </main>
    <slot name="footer" />
    <ExitIntentModal />
    <script>
      // Brilho que segue o ponteiro nos cartoes. Enfeite puro, entao mora
      // longe do caminho que decide se o conteudo aparece.
      document.querySelectorAll('.service-card, .who-card').forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const mouseEvent = e as MouseEvent;
          (card as HTMLElement).style.setProperty('--mx', `${mouseEvent.clientX - rect.left}px`);
          (card as HTMLElement).style.setProperty('--my', `${mouseEvent.clientY - rect.top}px`);
        });
      });
    </script>
  </body>
</html>
