---
// src/layouts/BaseLayout.astro
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/600.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import ExitIntentModal from '../components/ExitIntentModal.astro';
import JsonLd from '../components/JsonLd.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { empresa } from '../data/empresa';

interface Props {
  title: string;
  description: string;
  /**
   * Imagem de compartilhamento e o texto que a descreve. Andam juntos de
   * propósito: um alt que descreve outra imagem é pior que nenhum, e prop
   * separado deixaria trocar só a imagem e esquecer o alt.
   */
  og?: { imagem: string; alt: string };
  /** og:type. "article" nas paginas de conteudo, "website" no resto. */
  ogType?: string;
  extraJsonLd?: Record<string, unknown>[];
}

const OG_PADRAO = {
  imagem: '/og/default.png',
  alt: 'Cartão da R.A.F.O. com o nome da marca, a frase Agentes de IA no WhatsApp e sites, e a linha Resende, RJ. Atendemos todo o Brasil.',
};

const { title, description, og = OG_PADRAO, ogType = 'website', extraJsonLd } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(og.imagem, Astro.site);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--
      Google Tag Manager. É a única ferramenta de medição instalada no
      código: Analytics, Clarity e o que vier depois entram pelo painel do
      GTM. Mora neste layout, e não em public/, de propósito: as páginas
      de /propostas/ e /modelos/ não passam por aqui, então visita de
      cliente não entra na medição do site.

      O bloco de consentimento vem ANTES do GTM, de propósito: o padrão
      precisa estar declarado quando o GTM ler a dataLayer. Sem escolha
      salva, tudo começa negado (LGPD); quem já aceitou em outra visita
      começa liberado, sem esperar o aviso. Anúncio fica sempre negado,
      porque o site não roda anúncio. A escolha é feita no CookieBanner.
    -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      (function () {
        var escolha = null;
        try { escolha = localStorage.getItem('rafo-cookies'); } catch (e) {}
        gtag('consent', 'default', {
          analytics_storage: escolha === 'aceito' ? 'granted' : 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          functionality_storage: 'granted',
          security_storage: 'granted',
          wait_for_update: 500
        });
      })();

      // Clique em qualquer link de WhatsApp vira o evento `clique_whatsapp`
      // na dataLayer, com a página de origem. No GTM ele alimenta um evento
      // do GA4, que só é enviado se houver consentimento.
      document.addEventListener('click', function (e) {
        var link = e.target && e.target.closest && e.target.closest('a[href*="wa.me/"]');
        if (!link) return;
        dataLayer.push({ event: 'clique_whatsapp', pagina_origem: location.pathname });
      });
    </script>
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-5Z53BTSR');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" sizes="192x192" href="/logo/rafo-compact.png" />
    <link rel="apple-touch-icon" href="/logo/rafo-compact.png" />

    <meta name="robots" content="index,follow,max-image-preview:large" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={empresa.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />

    <JsonLd extra={extraJsonLd} />

    <script is:inline>
      // A revelacao ao rolar e feita em CSS puro por animation-timeline.
      // Este bloco existe so para o navegador que ainda nao tem isso, e e
      // deliberadamente conservador: so esconde conteudo se tiver, aqui e
      // agora, como revelar de volta. Sem JS, sem IntersectionObserver ou
      // sem os dois, a pagina chega inteira e visivel. Roda antes da
      // pintura para nao piscar.
      (function () {
        var temTimeline = window.CSS && CSS.supports && CSS.supports('animation-timeline: view()');
        if (temTimeline || !('IntersectionObserver' in window)) return;
        var raiz = document.documentElement;
        raiz.classList.add('sem-scroll-timeline');
        document.addEventListener('DOMContentLoaded', function () {
          var observador = new IntersectionObserver(
            function (entradas) {
              for (var i = 0; i < entradas.length; i++) {
                if (!entradas[i].isIntersecting) continue;
                entradas[i].target.classList.add('is-visible');
                observador.unobserve(entradas[i].target);
              }
            },
            { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
          );
          var alvos = document.querySelectorAll('[data-reveal]');
          for (var i = 0; i < alvos.length; i++) observador.observe(alvos[i]);
        });
      })();
    </script>
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5Z53BTSR"
height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    <a class="pular-para-conteudo" href="#conteudo">Pular para o conteúdo</a>
    <SiteHeader />
    <main id="conteudo">
      <slot />
    </main>
    <slot name="footer" />
    <ExitIntentModal />
    <CookieBanner />
    <script>
      // Brilho que segue o ponteiro nos cartoes. Enfeite puro, entao mora
      // longe do caminho que decide se o conteudo aparece.
      document.querySelectorAll('.service-card, .who-card').forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const mouseEvent = e as MouseEvent;
          (card as HTMLElement).style.setProperty('--mx', `${mouseEvent.clientX - rect.left}px`);
          (card as HTMLElement).style.setProperty('--my', `${mouseEvent.clientY - rect.top}px`);
        });
      });
    </script>
  </body>
</html>
