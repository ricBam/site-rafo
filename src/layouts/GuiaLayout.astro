---
// src/layouts/GuiaLayout.astro
//
// Renderiza um guia e monta o JSON-LD dele a partir do mesmo frontmatter
// que gera o texto visível, mantendo a regra das fases anteriores: o
// schema nunca é uma segunda cópia do conteúdo.
import BaseLayout from './BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FaqList from '../components/FaqList.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { artigoNode, trilhaNode, faqNodeDe } from '../lib/schema';
import { servicos } from '../data/servicos';
import { empresa } from '../data/empresa';

interface Props {
  guia: {
    titulo: string;
    descricao: string;
    resposta: string;
    publicadoEm: Date;
    atualizadoEm: Date;
    servicoRelacionado: string | null;
    resumo: string[];
    faq: { pergunta: string; resposta: string }[];
  };
}

const { guia } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const servico = guia.servicoRelacionado
  ? servicos.find((s) => s.slug === guia.servicoRelacionado)
  : undefined;

const dataLegivel = guia.atualizadoEm.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
const dataMaquina = guia.atualizadoEm.toISOString().slice(0, 10);
---
<BaseLayout
  title={guia.titulo}
  description={guia.descricao}
  ogType="article"
  extraJsonLd={[
    artigoNode(guia, canonical),
    faqNodeDe(guia.faq),
    trilhaNode([
      { nome: 'Início', url: `${empresa.url}/` },
      { nome: 'Guias', url: `${empresa.url}/guias/` },
      { nome: guia.titulo, url: canonical },
    ]),
  ]}
>
  <article class="section">
    <div class="container guia">
      <div class="page-head">
        <p class="trilha">
          <a href="/">Início</a> <span aria-hidden="true">/</span> <a href="/guias/">Guias</a>
        </p>
        <h1>{guia.titulo}</h1>
        <p class="page-meta">
          Atualizado em <time datetime={dataMaquina}>{dataLegivel}</time>
          <span aria-hidden="true"> · </span>{empresa.nome}
        </p>
      </div>

      <div class="resposta" data-reveal>
        <span class="resposta-rotulo">resposta direta</span>
        <p class="resposta-texto" data-resposta>{guia.resposta}</p>
      </div>

      <div class="guia-corpo prose" data-corpo data-reveal>
        <slot />
      </div>

      <section class="guia-bloco" data-reveal>
        <h2>Em resumo</h2>
        <ul class="guia-resumo lista-marcada" data-resumo>
          {guia.resumo.map((item) => <li><span>{item}</span></li>)}
        </ul>
      </section>

      <section class="guia-bloco" data-reveal>
        <h2>Perguntas frequentes</h2>
        <FaqList faq={guia.faq} />
      </section>

      {servico && (
        <section class="guia-servico" data-reveal>
          <h2>Como a {empresa.nome} resolve isso</h2>
          <p>
            <a href={`/${servico.slug}/`}>{servico.nome}</a>: {servico.descricao}
          </p>
          <WhatsAppButton label="Falar sobre isso no WhatsApp" />
        </section>
      )}

      <p class="guia-voltar">
        <a class="btn-fantasma" href="/guias/">
          <span class="seta" aria-hidden="true">&larr;</span> Ver todos os guias
        </a>
      </p>
    </div>
  </article>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  /* Nada de max-width em .guia: ela divide o elemento com .container, e
     qualquer valor aqui vence o 1100px de lá e derruba o `margin: 0 auto`
     que centraliza a página. A largura de leitura é aplicada nos blocos
     de dentro, um a um. */
  .guia .page-head,
  .guia-corpo,
  .guia-bloco,
  .guia-servico,
  .guia-voltar { max-width: var(--wrap-texto); }

  .guia-bloco { margin-top: var(--space-xl); }
  .guia-bloco h2,
  .guia-servico h2 {
    font-size: var(--step-2);
    margin-bottom: var(--space-m);
  }

  /* O corpo do guia vem de Markdown, entao a estilizacao dele precisa
     alcancar elementos que este arquivo nao escreve. */
  .guia-corpo :global(h2) {
    font-family: var(--font-heading);
    font-size: var(--step-2);
    color: var(--color-ink);
    letter-spacing: -0.02em;
    margin: var(--space-xl) 0 var(--space-s);
  }
  .guia-corpo :global(h3) {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    color: var(--color-ink);
    margin: var(--space-l) 0 var(--space-2xs);
  }
  .guia-corpo :global(p) { line-height: 1.75; margin-bottom: var(--space-s); }
  .guia-corpo :global(ul),
  .guia-corpo :global(ol) {
    padding-left: 1.25rem;
    line-height: 1.75;
    margin-bottom: var(--space-s);
  }
  .guia-corpo :global(li) { margin-bottom: var(--space-3xs); }
  .guia-corpo :global(a) {
    color: var(--color-accent-secondary);
    text-underline-offset: 3px;
  }
  .guia-corpo :global(strong) { color: var(--color-ink); }

  .guia-servico {
    margin-top: var(--space-xl);
    padding: var(--space-m);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--raio);
  }
  .guia-servico p { margin-bottom: var(--space-m); line-height: 1.7; }
  .guia-servico a { color: var(--color-accent-secondary); }

  .guia-voltar { margin-top: var(--space-xl); }
</style>
