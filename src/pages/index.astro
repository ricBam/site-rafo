---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ChatMockup from '../components/ChatMockup.astro';
import Services from '../components/Services.astro';
import HowItWorks from '../components/HowItWorks.astro';
import WhoItsFor from '../components/WhoItsFor.astro';
import Faq from '../components/Faq.astro';
import SiteFooter from '../components/SiteFooter.astro';

const title = 'R.A.F.O.: Automação de atendimento e sites institucionais sob medida';
const description = 'Cuidamos da sua presença online de ponta a ponta: Google Negócio, site institucional e automação de atendimento no WhatsApp, tudo sob medida pro seu negócio.';
---
<BaseLayout title={title} description={description}>
  <Hero />
  <ChatMockup />
  <Services />
  <HowItWorks />
  <WhoItsFor />
  <Faq />
  <SiteFooter slot="footer" />
</BaseLayout>
