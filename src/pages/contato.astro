---
// src/pages/contato.astro
//
// Só canais que a empresa realmente publicou. Nada de email de fachada
// nem de horário de atendimento que ninguém combinou: a verificação
// falha o build se aparecer.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { empresa } from '../data/empresa';
import { rotuloDoPerfil } from '../lib/perfis';

const title = 'Contato da R.A.F.O.: fale direto no WhatsApp';
const description =
  'Fale com a R.A.F.O. pelo WhatsApp para um diagnóstico gratuito e sem compromisso. Baseada em Resende, RJ, atendendo todo o Brasil de forma remota.';

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const contactPage = {
  '@type': 'ContactPage',
  name: title,
  description,
  url: canonical,
  inLanguage: 'pt-BR',
  about: { '@id': `${empresa.url}/#negocio` },
};
---
<BaseLayout title={title} description={description} extraJsonLd={[contactPage]}>
  <section class="section">
    <div class="container">
      <div class="page-head">
        <p class="trilha"><a href="/">Início</a> <span aria-hidden="true">/</span> Contato</p>
        <h1>Falar com a gente</h1>
      </div>

      <div class="resposta" data-reveal>
        <span class="resposta-rotulo">resposta direta</span>
        <p class="resposta-texto">
          O caminho mais rápido é o WhatsApp. A primeira conversa é um diagnóstico
          gratuito, sem compromisso: a gente entende como seu atendimento funciona
          hoje e onde dá pra melhorar, e você decide se quer seguir.
        </p>
      </div>

      <div class="contato-cta" data-reveal>
        <WhatsAppButton label="Quero meu diagnóstico gratuito" />
      </div>

      <section class="contato-bloco" data-reveal>
        <h2>Canais</h2>
        <ul class="canais">
          <li>
            <a href={empresa.whatsapp} rel="noopener" target="_blank">
              <span class="canal-nome">WhatsApp</span>
              <span class="canal-valor">{empresa.telefone} <span class="seta" aria-hidden="true">&rarr;</span></span>
            </a>
          </li>
          {empresa.perfis.map((perfil) => (
            <li>
              <a href={perfil} rel="me noopener" target="_blank">
                <span class="canal-nome">{rotuloDoPerfil(perfil)}</span>
                <span class="canal-valor">{perfil} <span class="seta" aria-hidden="true">&rarr;</span></span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="contato-bloco" data-reveal>
        <h2>Onde ficamos</h2>
        <p class="contato-local">{empresa.atendimento}</p>
      </section>

      <p class="contato-voltar" data-reveal>
        <a class="btn-fantasma" href="/">
          <span class="seta" aria-hidden="true">&larr;</span> Voltar para a página inicial
        </a>
      </p>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .contato-cta { margin-bottom: var(--space-xl); }

  .contato-bloco { margin-top: var(--space-xl); max-width: var(--wrap-texto); }
  .contato-bloco h2 { font-size: var(--step-2); margin-bottom: var(--space-m); }

  .canais { list-style: none; padding: 0; display: grid; gap: 0; }
  .canais a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs);
    padding: var(--space-s) 0;
    border-top: 1px solid var(--color-border);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease-saida);
  }
  .canais li:last-child a { border-bottom: 1px solid var(--color-border); }
  .canais a:hover { border-top-color: var(--color-accent-secondary); }
  .canal-nome {
    font-family: var(--font-heading);
    font-size: var(--step-0);
    color: var(--color-ink);
  }
  .canal-valor {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-accent-secondary);
    overflow-wrap: anywhere;
  }

  .contato-local { line-height: 1.7; }
  .contato-voltar { margin-top: var(--space-xl); }
</style>
